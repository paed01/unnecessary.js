{
  "name": "unnecessary",
  "version": "3.0.0",
  "description": "Check for files not required throughout the project",
  "author": {
    "name": "Pål Edman",
    "url": "https://github.com/paed01"
  },
  "type": "module",
  "main": "./main.cjs",
  "module": "./index.js",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./main.cjs"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "mocha",
    "posttest": "eslint . --cache",
    "cov:html": "npm run build && c8 --reporter=html mocha",
    "format": "prettier . --write",
    "test:lcov": "npm run build && c8 --reporter=lcov mocha && npm run posttest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paed01/unnecessary.js.git"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "main.cjs"
  ],
  "keywords": [
    "unused",
    "unnecessary",
    "not required",
    "require cache",
    "project",
    "tree",
    "lightweight coverage"
  ],
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/paed01/unnecessary.js/issues"
  },
  "homepage": "https://github.com/paed01/unnecessary.js#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "rollup": "^4.0.0"
  }
}
